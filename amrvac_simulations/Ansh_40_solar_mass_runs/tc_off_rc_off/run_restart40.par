! Purpose: Resume the 40 Msun TC-off/RC-off checkpoint with conservative AMR and copied coarse-fine ghosts.
! Use as the sole input: ../amrvac -i run_restart40.par
! Requires the recovered user module printing 'User-module conservative refinement: T'.
! Keep the existing output folder and retain the checkpoint's gas, stellar age, and iteration.
&filelist
 restart_from_file='output/test0042.dat'
 firstprocess=.false.
 reset_grid=.false.
 base_filename='output/test'
 saveprim=.true.
 autoconvert=.true.
 convert_type='vtuBmpi'
 nwauxio=1
/
&savelist
 itsave(1,1)=0
 itsave(1,2)=0
 ditsave_log=10000
 ! Save every 10000 years, reducing progress lost if another issue occurs.
 dtsave_dat=1.02200473150338667d0
/
&stoplist
 reset_time=.false.
 reset_it=.false.
 time_max=4.87496256927115382d2
 it_max=1000000000
 wall_time_max=1.d99
 final_dt_reduction=.true.
 dtmin=1.d-14
/
&methodlist
 time_stepper='threestep'
 flux_scheme=20*'tvdlf'
 limiter=20*'minmod'
 loglimit(1)=.true.
 loglimit(3)=.true.
 check_small_values=.true.
 fix_small_values=.true.
 small_values_method='replace'
 small_temperature=0.d0
 small_pressure=1.d-14
 small_density=1.d-14
/
&boundlist
 ! First-order coarse-fine ghost copying avoids invalid linear reconstructions.
 ghost_copy=.true.
 typeboundary_min1='special','special','special'
 typeboundary_max1='special','special','special'
/
&meshlist
 ! Keep refinement/restriction on conserved variables; the user hook handles invalid child pairs.
 coarsenprimitive=.false.
 prolongprimitive=.false.
 refine_criterion=3
 refine_max_level=3
 w_refine_weight(1)=0.7d0
 w_refine_weight(2)=0.d0
 w_refine_weight(3)=0.d0
 w_refine_weight(4)=0.3d0
 refine_threshold=20*0.05d0
 derefine_ratio=20*0.1d0
 domain_nx1=192
 block_nx1=8
 xprobmin1=0.01d0
 xprobmax1=20.d0
 stretch_dim(1)='uni'
 qstretch_baselevel(1)=1.03d0
/
&paramlist
 typecourant='maxsum'
 courantpar=0.1d0
 slowsteps=50
/
&hd_list
 hd_energy=.true.
 hd_gamma=1.6666666666666667d0
 hd_thermal_conduction=.false.
 hd_radiative_cooling=.false.
/
&tc_list
 tc_saturate=.true.
/
&sts_list
 sts_method=1
 sts_dtpar=0.4d0
 sts_ncycles=1000
 sourcetype_sts=2
/
&rc_list
 coolcurve='SPEX_DM'
 coolmethod='exact'
 ! Retain the cooling configuration; it is inactive in this RC-off run.
 Tfix=.true.
/
&usr_list
 amr_pair_fallback=.true.
 ambient_particles_cm3=1.d4
 ambient_temperature_k=100.d0
 stellar_param_file='../stellar_evolution.dat'
 guard_ulps=32.d0
 guard_max_cell_fraction=1.d-3
 guard_max_budget_fraction=1.d-3
/
