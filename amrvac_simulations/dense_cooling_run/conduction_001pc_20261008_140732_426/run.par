!=====================================================
! Constant wind: 2000 km/s, 1e-5 Msun/yr, for one million years
!=====================================================

&filelist
        base_filename = 'conduction_001pc_20261008_140732_426/test'
        saveprim      = .true.
        autoconvert   = .true.
        convert_type  = 'vtuBmpi'        
        nwauxio       = 1
/

&savelist
        itsave(1,1)=0
        itsave(1,2)=0
        ditsave_log= 10000
        ! Save every 100,000 years (AMRVAC uses 3.1536e7 seconds/year).
        dtsave_dat= 10.22004731503387d0
/

&stoplist
        time_max=102.2004731503387d0
        dtmin= 1.0d-12
/

&methodlist
        ! SSPRK3 allocates ps2 geometry needed by STS + spherical AMR in v3.1.
        time_stepper     = 'threestep'
        flux_scheme      = 20*'tvdlf'
        limiter          = 20*'minmod'
        loglimit(1) = .true.
        loglimit(3) = .true.
        check_small_values = .true.
        fix_small_values = .true.
        ! Invoke validation, but stop on bad states instead of replacing them.
        small_values_method='error'
        small_temperature = 0.0d0
        small_pressure = 1.0d-16
        small_density = 1.0d-14
/

&boundlist
        typeboundary_min1 = 'special','special','special'
        typeboundary_max1 = 'special','special','special'
/

&meshlist
	refine_criterion=3
	refine_max_level=4
        ! Conserved slots: rho, radial momentum, total energy.
        ! Slot nw+1=4 is thermal pressure from myvar_for_errest.
	w_refine_weight(1)=0.7d0
	w_refine_weight(2)=0.0d0
	w_refine_weight(3)=0.0d0
	w_refine_weight(4)=0.3d0
	refine_threshold = 20*0.05d0
	derefine_ratio = 20*0.1D0
	domain_nx1=192
	block_nx1=8
	xprobmin1=0.01D0
	xprobmax1=8.0d0
/

&paramlist
        typecourant = 'maxsum'
        courantpar  = 0.2d0
        slowsteps=50
/

&hd_list
        hd_energy             = .true.
        hd_radiative_cooling  = .true.
        hd_thermal_conduction = .true.
/

&tc_list
        tc_saturate = .true.
/

&sts_list
        sts_method = 1
        sts_dtpar = 0.8d0
        sts_ncycles = 1000
        sourcetype_sts = 2
/

&rc_list
	coolcurve   = 'SPEX_DM'
        coolmethod = 'exact'
        ! Cooling cutoff follows ism_temperature_k; do not reheat gas.
        Tfix       = .false.
/

&usr_list
       icase = 1
       ! Ambient mass density in g cm^-3; used by initialization and outer BC.
       rho_ism_cgs = 1.6726d-20
       ism_temperature_k = 100.0d0
       use_stellar_evolution = .false.
       stellar_param_file = 'stellar_evolution.dat'
/

/
