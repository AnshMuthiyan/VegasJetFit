! van Marle, Meliani & Marcowith (2012), A&A 541 L8.
! PILOT INPUT ONLY: 120x240 base cells, maximum AMR level 2.
! Case star25__conduction; no production run is authorized by this file.
&filelist
  base_filename = 'output/star25__conduction'
  saveprim = .true.
  autoconvert = .true.
  convert_type = 'vtuBmpi'
/
&savelist
  itsave(1,1) = 0
  itsave(1,2) = 0
  ditsave_log = 1000
  dtsave_dat = 1.0220047315033867e+01
/
&stoplist
  time_max = 7.2562335936740453e+02
  final_dt_reduction = .true.
  dtmin = 1.0d-12
/
&methodlist
  time_stepper = 'threestep'
  flux_scheme = 20*'tvdlf'
  limiter = 20*'minmod'
  loglimit(1) = .true.
  loglimit(4) = .true.
  check_small_values = .true.
  fix_small_values = .true.
  small_values_method = 'error'
  small_pressure = 1.0d-16
  small_density = 1.0d-14
/
&boundlist
  typeboundary_min1 = 'symm','asymm','symm','symm'
  typeboundary_max1 = 4*'cont'
  typeboundary_min2 = 4*'cont'
  typeboundary_max2 = 4*'cont'
/
&meshlist
  refine_criterion = 3
  refine_max_level = 2
  w_refine_weight(1) = 0.5d0
  w_refine_weight(2) = 0.25d0
  w_refine_weight(3) = 0.25d0
  refine_threshold = 20*0.15d0
  derefine_ratio = 20*0.1d0
  domain_nx1 = 120
  domain_nx2 = 240
  block_nx1 = 8
  block_nx2 = 8
  xprobmin1 = 0.0d0
  xprobmax1 = 100.0d0
  xprobmin2 = -100.0d0
  xprobmax2 = 100.0d0
/
&paramlist
  typecourant = 'maxsum'
  courantpar = 0.3d0
  slowsteps = 50
/
&hd_list
  hd_energy = .true.
  hd_radiative_cooling = .false.
  hd_thermal_conduction = .true.
/
&tc_list
  tc_saturate = .true.
/
&sts_list
  sts_method = 1
  sts_dtpar = 0.8d0
  sts_ncycles = 1000
  sourcetype_sts = 2
/
&rc_list
  ! SPEX_DM is a proxy; the paper's CLOUDY table is not available here.
  coolcurve = 'SPEX_DM'
  coolmethod = 'exact'
  Tfix = .true.
  tlow = 1.3560799792401208e-04
/
&usr_list
  case_id = 2
/
