! Finite tapered cloud; density parameter is n_H at 1 pc.
&filelist
  base_filename = 'cloudmass_nref3000_atmosphere'
  saveprim = .true.
  autoconvert = .true.
  convert_type = 'vtuBmpi'
/
&savelist
  dtsave_dat = 1.0220121568819215e+01
/
&stoplist
  time_max = 1.0220121568819215e+01
  final_dt_reduction = .true.
  dtmin = 1.0d-12
/
&hd_list
  hd_gravity = .true.
/
&usr_list
  n_ref_cm3 = 3000.0d0
  wind_enabled = .false.
  ionization_enabled = .false.
  cloud_gravity_enabled = .true.
/
