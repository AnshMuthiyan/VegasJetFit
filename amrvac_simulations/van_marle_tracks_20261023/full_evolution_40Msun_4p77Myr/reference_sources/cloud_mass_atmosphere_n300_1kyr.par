! Finite-cloud Newtonian gravity atmosphere gate, no wind or ionization.
&filelist
  base_filename = 'cloud_mass_atmosphere_n300_1kyr'
  saveprim = .true.
  autoconvert = .true.
  convert_type = 'vtuBmpi'
/
&savelist
  dtsave_dat = 1.0220121568819214d-1
/
&stoplist
  time_max = 1.0220121568819214d-1
  final_dt_reduction = .true.
  dtmin = 1.0d-12
/
&hd_list
  hd_gravity = .true.
/
&usr_list
  n_ref_cm3 = 300.0d0
  wind_enabled = .false.
  ionization_enabled = .false.
  cloud_gravity_enabled = .true.
/
