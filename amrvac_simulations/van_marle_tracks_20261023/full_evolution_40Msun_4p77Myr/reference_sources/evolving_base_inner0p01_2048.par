! Smaller 0.01 pc inner boundary; distinct density series, 2048-cell short checks.
&filelist
  base_filename = 'output/'
/
&savelist
  itsave(1,1) = 0
  itsave(1,2) = 0
  ditsave_log = 1000
/
&methodlist
  time_stepper = 'threestep'
  flux_scheme = 20*'tvdlf'
  limiter = 20*'minmod'
  loglimit(1) = .true.
  loglimit(3) = .true.
  check_small_values = .true.
  fix_small_values = .true.
  small_values_method = 'error'
  small_pressure = 1.0d-16
  small_density = 1.0d-14
/
&boundlist
  typeboundary_min1 = 3*'special'
  typeboundary_max1 = 3*'special'
/
&meshlist
  refine_max_level = 1
  domain_nx1 = 2048
  block_nx1 = 8
  xprobmin1 = 0.01d0
  xprobmax1 = 40.0d0
  stretch_dim(1) = 'uni'
  qstretch_baselevel(1) = 1.0012445651859097d0
/
&paramlist
  typecourant = 'maxsum'
  courantpar = 0.2d0
  slowsteps = 10
/
&hd_list
  hd_energy = .true.
  hd_radiative_cooling = .false.
  hd_thermal_conduction = .false.
/
&usr_list
  n0_cm3 = 2.0d3
  rc_pc = 1.0d0
  cloud_pc = 2.0d0
  support_kms = 0.72d0
  q_ms = 2.0d49
  q_rsg = 0.0d0
  q_wr = 2.0d49
/
